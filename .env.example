# Copy to .env and fill in. Never commit .env.

# Supabase > Connect > Transaction pooler (port 6543). Used by the running app.
DATABASE_URL=
# Supabase > Connect > Session pooler or direct connection (port 5432). Used by migrations and scripts.
DIRECT_URL=

# Supabase > Project Settings > API. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Not used by this application: uploads run as the signed-in admin and are checked by Storage RLS.
# Leave empty unless you add your own maintenance scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site origin, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional contact notifications. Messages are stored even when these are empty.
RESEND_API_KEY=
# Where notifications are delivered.
CONTACT_EMAIL=
# Sender on a domain verified in Resend, e.g. Portfolio <contact@example.com>
CONTACT_FROM_EMAIL=

# Required for the contact form. Random string (openssl rand -hex 32).
# Keys the hash of sender IPs used for rate limiting.
CONTACT_IP_SALT=
